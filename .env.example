# Base de datos
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ig_dm_engine

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXX

# Perplexity (optional if using Google Gemini)
PERPLEXITY_API_KEY=pplx-XXXXXX

# Google Gemini (alternative to Perplexity for research)
GOOGLE_API_KEY=AIzaSy-XXXXXX

# Apify
APIFY_API_TOKEN=apify_api_XXXXXX

# API Authentication
# Comma-separated list of valid API keys for X-API-Key header authentication.
# Generate keys with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Set to False to disable API key auth (e.g. for local development)
API_AUTH_ENABLED=True

# User Authentication (JWT)
# Secret key for signing tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# App
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_SCORE_THRESHOLD=60
RESEARCH_SCORE_THRESHOLD=60
DM_SCORE_THRESHOLD=70

# Slack Notifications (optional)
# Create an Incoming Webhook at https://api.slack.com/apps → Incoming Webhooks
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=

# Phase 2 — Instagram DM Sending
IG_USERNAME=
IG_PASSWORD=
PROXY_URL=
DAILY_DM_LIMIT=30
DM_DELAY_MIN=45
DM_DELAY_MAX=120
IG_SESSION_DIR=./ig_sessions

# Multi-account rotation (comma-separated user:pass:proxy entries)
# IG_ACCOUNTS=bot1:pass1:http://proxy1:8080,bot2:pass2:http://proxy2:8080

# Warm-up settings for new accounts
IG_WARMUP_DAYS=7
IG_WARMUP_START_LIMIT=5
